{
  "name": "ts-design-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ts-design-system/src",
  "prefix": "ts",
  "projectType": "library",
  "tags": ["scope:design-system", "type:lib"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/ts-design-system/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build-elements": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "web",
        "compiler": "tsc",
        "outputPath": "dist/packages/ts-design-system-elements",
        "main": "packages/ts-design-system/src/elements.ts",
        "tsConfig": "packages/ts-design-system/tsconfig.elements.json",
        "webpackConfig": "packages/ts-design-system/webpack.elements.config.js"
      }
    }
  }
}
