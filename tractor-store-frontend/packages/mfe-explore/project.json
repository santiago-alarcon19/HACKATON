{
  "name": "mfe-explore",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "explore",
  "sourceRoot": "packages/mfe-explore/src",
  "tags": ["scope:mfe-explore", "type:mfe"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/mfe-explore",
        "index": "packages/mfe-explore/src/index.html",
        "main": "packages/mfe-explore/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "packages/mfe-explore/tsconfig.app.json",
        "assets": ["packages/mfe-explore/src/assets"],
        "styles": ["packages/mfe-explore/src/styles.scss"],
        "customWebpackConfig": {
          "path": "packages/mfe-explore/webpack.config.js"
        }
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:webpack-dev-server",
      "options": {
        "port": 4201,
        "publicHost": "http://localhost:4201",
        "buildTarget": "mfe-explore:build:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "mfe-explore:build:production"
        },
        "development": {
          "buildTarget": "mfe-explore:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
